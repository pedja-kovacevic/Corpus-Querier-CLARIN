    a.scripts,
    a.binaries,
    a.datas,
    [],
    name="Corpus Querier",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
